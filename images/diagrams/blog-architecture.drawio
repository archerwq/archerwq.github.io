          <mxGeometry x="240" y="100" width="240" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="cn4" value="_layouts/&#xa;页面布局" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Comic Sans MS;fontSize=12;" vertex="1" parent="c2">
          <mxGeometry x="10" y="48" width="105" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="cn5" value="_includes/&#xa;可复用组件" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Comic Sans MS;fontSize=12;" vertex="1" parent="c2">
          <mxGeometry x="125" y="48" width="105" height="50" as="geometry"/>
