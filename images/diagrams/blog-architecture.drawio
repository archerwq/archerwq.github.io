        <mxCell id="cn6" value="_sass/  样式" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Comic Sans MS;fontSize=12;" vertex="1" parent="c2">
          <mxGeometry x="10" y="110" width="105" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="cn7" value="css/ + js/" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Comic Sans MS;fontSize=12;" vertex="1" parent="c2">
          <mxGeometry x="125" y="110" width="105" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="cn8" value="fonts/  images/" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Comic Sans MS;fontSize=12;" vertex="1" parent="c2">
          <mxGeometry x="10" y="145" width="220" height="22" as="geometry"/>
        </mxCell>

        <!-- Config -->
        <mxCell id="c3" value="配置层" style="swimlane;startSize=28;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=2;fontColor=#333333;fontStyle=1;fontFamily=Comic Sans MS;fontSize=13;align=center;swimlaneLine=1;" vertex="1" parent="1">
          <mxGeometry x="500" y="100" width="200" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="cn10" value="_config.yml&#xa;主题 / 插件 / 分页 / Giscus" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Comic Sans MS;fontSize=12;" vertex="1" parent="c3">
          <mxGeometry x="12" y="48" width="176" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="cn11" value="CNAME  自定义域名" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Comic Sans MS;fontSize=12;" vertex="1" parent="c3">
          <mxGeometry x="12" y="4" width="176" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="cn12" value="git/  版本管理" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Comic Sans MS;fontSize=12;" vertex="1" parent="c3">
          <mxGeometry x="12" y="102" width="176" height="24" as="geometry"/>
        </mxCell>

        <!-- ===== TIER 2: BUILD (centered below TIER 1, with clear corridor) ===== -->
        <!-- Clear corridor: y=290 to y=340, no shapes here -->

        <mxCell id="b1" value="Jekyll" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=3;align=center;verticalAlign=middle;fontFamily=Comic Sans MS;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="350" width="120" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="b2" value="静态 HTML / CSS / JS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=3;align=center;verticalAlign=middle;fontFamily=Comic Sans MS;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="420" width="120" height="45" as="geometry"/>
        </mxCell>

        <!-- Arrows: TIER1 → BUILD, each with distinct exit/entry to avoid overlap -->
        <!-- Content (left) → Jekyll: go RIGHT then DOWN (exitX=1, entry from left) -->
        <mxCell id="a1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#999999;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cn1" target="b1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- Template (middle) → Jekyll: go DOWN (exitY=1 from bottom of cn8, entry from top) -->
        <mxCell id="a2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#999999;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cn8" target="b1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- Config (right) → Jekyll: go LEFT then DOWN (exitX=0, entry from right) -->
        <mxCell id="a3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#999999;strokeWidth=2;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cn10" target="b1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- Jekyll → Output -->
        <mxCell id="a4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#333333;strokeWidth=3;" edge="1" parent="1" source="b1" target="b2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ===== TIER 3: OUTPUT SERVICES (below TIER 2) ===== -->
        <!-- Clear corridor: y=485 to y=530, no shapes here -->

        <mxCell id="s1" value="GitHub Pages&#xa;托管 + 部署" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=3;align=center;verticalAlign=middle;fontFamily=Comic Sans MS;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="80" y="545" width="150" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="s2" value="Giscus&#xa;GitHub Discussions&#xa;评论系统" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=2;dashed=1;align=center;verticalAlign=middle;fontFamily=Comic Sans MS;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="580" y="420" width="170" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="s3" value="pic.imgdb.cn&#xa;图片 CDN" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=2;dashed=1;align=center;verticalAlign=middle;fontFamily=Comic Sans MS;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="580" y="500" width="170" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="s4" value="archerwq.cn&#xa;自定义域名" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=2;dashed=1;align=center;verticalAlign=middle;fontFamily=Comic Sans MS;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="580" y="565" width="170" height="45" as="geometry"/>
        </mxCell>

        <!-- Arrows: Output → Services -->
        <!-- Output → GitHub Pages: go LEFT then DOWN -->
        <mxCell id="a5" value="git push" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#999999;strokeWidth=2;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b2" target="s1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- Output → Giscus: go RIGHT -->
        <mxCell id="a6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#999999;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b2" target="s2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- Output → CDN: go RIGHT then DOWN -->
        <mxCell id="a7" value="img/" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#999999;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b2" target="s3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- CDN → Domain: go DOWN -->
        <mxCell id="a8" value="CNAME" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#999999;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s3" target="s4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- GitHub Pages → Domain: go RIGHT -->
        <mxCell id="a9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#999999;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s1" target="s4">
          <mxGeometry relative="1" as="geometry"/>
